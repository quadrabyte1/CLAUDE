        <mxCell id="L16-callouts" parent="0" value="Callouts" />
        <mxCell id="v17-callout-ledger-0384" parent="L16-callouts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8ee;strokeColor=#cc8800;strokeWidth=1.5;opacity=100;dashed=0;fontColor=#663300;fontSize=6;" value="&lt;b&gt;LEDGER: ½&quot; HDG carriage bolts, back-blocked from&lt;/b&gt;&lt;br/&gt;&lt;b&gt;basement; ½&quot; HDG lag @ 18&quot; OC two-row staggered&lt;/b&gt;&lt;br/&gt;between connections (IRC R507.9.1.3). Wood-frame wall.&lt;br/&gt;Peel-and-stick + Z-flashing + kick-out at ends.&lt;br/&gt;DTT2Z lateral connectors (4× per IRC R507.9)." vertex="1">
          <mxGeometry height="66" width="220" x="1164" y="172" as="geometry" />
        </mxCell>
        <mxCell id="v17-callout-pier-0385" parent="L16-callouts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fdf0e0;strokeColor=#5a4030;strokeWidth=1.5;opacity=100;dashed=0;fontColor=#5a4030;fontSize=6;" value="&lt;b&gt;PYLEX 50 HELICAL PIER + 10555 SADDLE&lt;/b&gt;&lt;br/&gt;8 piers total — 4 per girder line&lt;br/&gt;Pier spacing: 7&#39;-8&quot; (within DCA-6 limit of 8&#39;-2&quot;)&lt;br/&gt;¼&quot; cedar/HDPE shims each side in saddle&lt;br/&gt;Doubled 2×10 (3.0&quot; wide) fits 3.5&quot; saddle" vertex="1">
          <mxGeometry height="70" width="180" x="426.7" y="380" as="geometry" />
        </mxCell>
        <mxCell id="v17-callout-hangers-0386" parent="L16-callouts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff0e8;strokeColor=#882200;strokeWidth=1.5;opacity=100;dashed=0;fontColor=#882200;fontSize=6;" value="&lt;b&gt;SIMPSON LUS210Z HDG — 100 total (order 110)&lt;/b&gt;&lt;br/&gt;25 @ ledger + 25 @ mid-girder S face + 25 @ mid-girder N face&lt;br/&gt;+ 25 @ outer-rim inboard face = 100 × 14 nails = 1,400 fasteners" vertex="1">
          <mxGeometry height="44" width="220" x="1164" y="482" as="geometry" />
        </mxCell>
        <mxCell id="v17-callout-decking-0387" parent="L16-callouts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8f4e8;strokeColor=#4a2a0a;strokeWidth=1.5;opacity=100;dashed=0;fontColor=#4a2a08;fontSize=6;" value="&lt;b&gt;FIELD DECKING (v17)&lt;/b&gt;&lt;br/&gt;MoistureShield Vision 5.4&quot; composite&lt;br/&gt;Runs x-direction (∥ house)&lt;br/&gt;Two 11&#39;-9&quot; halves per row,&lt;br/&gt;butting center divider breaker&lt;br/&gt;Tiger Claw TC-G hidden fasteners&lt;br/&gt;33 rows total (≈72×12-ft boards ordered)" vertex="1">
          <mxGeometry height="90" width="200" y="188" as="geometry" />
        </mxCell>
        <mxCell id="v17-callout-changes-0388" parent="L16-callouts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e8;strokeColor=#cc6600;strokeWidth=2.0;opacity=100;dashed=0;fontColor=#4a2200;fontSize=7;" value="&lt;b&gt;v17 CHANGES vs. v16&lt;/b&gt;&lt;br/&gt;• +1 center joist at x=11&#39;-6&quot; framing (16&#39;-0&quot; in 2 seg; hangers at ledger, mid-girder, outer-rim)&lt;br/&gt;• +1 center divider / breaker board (MoistureShield Vision PF stock, 5.4&quot;W × 16&#39;-0&quot; y-direction, x=11&#39;-9&quot; finish)&lt;br/&gt;• Decking now 11&#39;-9&quot; + 11&#39;-9&quot; per row — butt against breaker on both sides at x=11&#39;-9&quot; finish&lt;br/&gt;• Decking material change: was ~49×16-ft planks; now ~72×12-ft planks cut to 11&#39;-9&quot;" vertex="1">
          <mxGeometry height="80" width="400" x="248" y="40" as="geometry" />
        </mxCell>
        <mxCell id="v17-callout-heave-0389" parent="L16-callouts" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff0e0;strokeColor=#cc4400;strokeWidth=1.8;opacity=100;dashed=0;fontColor=#8B0000;fontSize=6;" value="&lt;b&gt;SEASONAL HEAVE NOTE (Hollis): shallow precast blocks WILL heave ¼-½&quot; per cycle.&lt;/b&gt;&lt;br/&gt;This is a decorative/convenience step, NOT frost-depth founded.&lt;br/&gt;Homeowner has accepted this trade-off.&lt;br/&gt;Step is separate from and does not affect left-edge stair." vertex="1">
          <mxGeometry height="58" width="300" x="560" y="834" as="geometry" />
        </mxCell>
